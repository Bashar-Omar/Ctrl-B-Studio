# Required. Create a limited OpenRouter API key for this test studio.
OPENROUTER_API_KEY=sk-or-v1-...

# Public HTTPS origin after Hostinger deployment. Required for uploaded reference images.
APP_URL=https://studio.ctrl-b.co

# Non-secret display conversion rate. Change whenever you want.
USD_TO_EGP_RATE=50.00

OPENROUTER_APP_NAME=CTRL-B Video Studio
MAX_UPLOAD_FILES=15
MAX_UPLOAD_MB=10
UPLOAD_TTL_HOURS=24

# Lightweight no-login safeguards for the public test URL.
MAX_GENERATIONS_PER_HOUR=10
MAX_UPLOADS_PER_HOUR=60
